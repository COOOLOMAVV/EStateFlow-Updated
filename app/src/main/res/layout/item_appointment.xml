<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E8E4DC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: title + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtApptTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    tools:text="439 East 14th Ave - Viewing" />

                <TextView
                    android:id="@+id/txtApptAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="439 East 14th Ave, Mount Pleasant" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtApptStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#2D6A4F"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                tools:text="Upcoming" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#F0EDE8" />

        <!-- Client info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 Client"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtApptClient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                tools:text="John Doe" />
        </LinearLayout>

        <!-- Date + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 When"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtApptDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                tools:text="Mon, Oct 14 • 1:30 PM" />
        </LinearLayout>

        <!-- Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏡 Type"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtApptType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                tools:text="Viewing" />
        </LinearLayout>

        <!-- Notes -->
        <TextView
            android:id="@+id/txtApptNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F8F7F3"
            android:padding="10dp"
            android:textColor="#555555"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Interested in rooftop deck access and parking dimensions." />

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/layoutApptActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApptCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Cancel"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApptConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#2D6A4F"
                android:text="Complete"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
