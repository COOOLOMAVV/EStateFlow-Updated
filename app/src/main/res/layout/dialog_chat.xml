<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Chat top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#F8F7F3">

        <ImageView
            android:id="@+id/btnCloseChat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="4dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtChatSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="#1C1C1E"
                android:textSize="15sp"
                android:text="Marcus Aurelius" />

            <TextView
                android:id="@+id/txtChatPropertyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2D6A4F"
                android:textSize="12sp"
                android:text="Cozy Family Townhouse" />
        </LinearLayout>
    </LinearLayout>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E4DC" />

    <!-- Message input area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/edtChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message..."
            android:textSize="14sp"
            android:textColor="#1C1C1E"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="44dp"
            android:background="@drawable/bg_search_bar"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="10dp" />

        <ImageButton
            android:id="@+id/btnSendChatMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_chat"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#2D6A4F"
            android:padding="10dp"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
